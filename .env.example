# Servicio `multas` (ver README, sección "Servicio de multas por Kafka").

# --- Kafka (mismos nombres que el resto del ecosistema) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=multas-microservice
KAFKA_CONSUMER_GROUP=multas-service
# Los tres tópicos del ecosistema (contrato: docs/08-contrato-tres-topicos.md del orquestador).
KAFKA_TOPICO_COMANDOS=crm.comandos
KAFKA_TOPICO_EVENTOS=crm.eventos
KAFKA_TOPICO_DLT=crm.dlt
# En Aiven: SASL_SSL, el mecanismo (PLAIN, SCRAM-SHA-256 o SCRAM-SHA-512), usuario, clave y el certificado de la CA.
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=ca.pem

# Intentos de procesar un comando ante un error inesperado antes de mandarlo a la DLT, y espera inicial (se duplica).
KAFKA_REINTENTOS_COMANDO=3
KAFKA_ESPERA_REINTENTO_SEGUNDOS=2

# Una consulta a la vez y esta pausa mínima entre una y otra (no saturar a la ANSV).
MULTAS_PAUSA_ENTRE_CONSULTAS_SEGUNDOS=5

# Puerto del /health.
PORT=8087
